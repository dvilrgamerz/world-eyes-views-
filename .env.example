# World Eyes View V2 — optional provider credentials
# Copy to .env for local Netlify development, or add these in Netlify's environment variables.
# Never commit real keys.

# OpenSky authenticated access improves civil-aircraft API reliability and quotas.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AISStream enables the live-vessel layer. The key stays server-side.
AISSTREAM_API_KEY=
